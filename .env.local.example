# Cloudflare Email Service — transactional email for contact form
# Account ID from the Cloudflare dashboard URL / API
CLOUDFLARE_ACCOUNT_ID=
# Email > sending token, scoped to Account.Email Routing Addresses / Email Service
CLOUDFLARE_EMAIL_TOKEN=

# Address contact form submissions get delivered to
CONTACT_TO_EMAIL=admin@makoai.studio

# Verified sender on the Cloudflare Email Service sending domain (makoai.studio)
CONTACT_FROM_EMAIL=admin@makoai.studio

# Cloudflare Turnstile — bot protection on the contact form.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to run without the captcha (rate limit + honeypot still active).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
